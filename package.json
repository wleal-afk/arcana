{
  "name": "arcana",
  "version": "1.0.0",
  "description": "Lectura de tarot programatica, con IA y magia integrada.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "bin": {
    "arcana": "./cli/arcana.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "cli": "node --env-file-if-exists=.env cli/arcana.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "better-sqlite3": "^11.5.0",
    "chalk": "^5.3.0",
    "express": "^4.21.1"
  }
}
