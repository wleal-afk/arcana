# requerida
ANTHROPIC_API_KEY=

PORT=3000
ARCANA_DB=./data/arcana.db
ARCANA_RETENTION_DAYS=180

# Nivel usado cuando el request no manda uno (un-disparo, smoke).
# El escalon lo marca la interpretacion, que es ~72% del gasto:
#   alta  = opus 5    ~$0.029 por lectura
#   media = sonnet 5  ~$0.014 por lectura
#   baja  = haiku 4.5 ~$0.006 por lectura
ARCANA_NIVEL_DEFAULT=alta

# Magia por corrida de terminal, en USD. La barra del REPL se calcula sobre
# esto. No es un tope real de gasto: cerrar y abrir la terminal la recarga.
ARCANA_PRESUPUESTO=0.20
