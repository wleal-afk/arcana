# requerida
ANTHROPIC_API_KEY=

PORT=3000
ARCANA_DB=./data/arcana.db
ARCANA_RETENTION_DAYS=180

# Los tres en Opus mientras se evalua la calidad.
# La palanca real de costo es INTERPRET (~95% del gasto):
#   claude-sonnet-5   ~40% mas barato
#   claude-haiku-4-5  ~7x mas barato
ARCANA_MODEL_INTERPRET=claude-opus-5
ARCANA_MODEL_ANALYSIS=claude-opus-5
ARCANA_MODEL_PROFILE=claude-opus-5
